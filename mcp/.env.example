# AI Agent MCP 서버 환경 변수 템플릿
# 복사하여 .env 파일로 저장하거나 mcp_config.json 에 직접 입력하세요.

# 1. GitHub MCP
# GitHub Settings -> Developer settings -> Personal access tokens (classic) -> repo, read:org 권한
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# 2. Portainer DS1019+ (HTTP)
PORTAINER_URL=http://djms1.iptime.org:9000
PORTAINER_API_KEY=ptr_your_api_key_here

# 3. Portainer DS920+ (HTTPS)
PORTAINER_DS920_URL=https://djms1.iptime.org:9101
PORTAINER_DS920_API_KEY=
PORTAINER_DS920_USERNAME=admin
PORTAINER_DS920_PASSWORD=your_password_here
